@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="false" />
<MudLayout>
       
    <MudPaper style="width:100%; height:110px; border:none; background-color:#f1f0ea">
        
        <MudImage Src="images/Logo_orange.png" Width="242" Height="70" Alt="Sentinel Logo" Style="margin-left:35px; margin-top:30px;" />
       
        <div class="column" style="width:150px; float:right; padding-right:50px; padding-top:55px;">
            <MudLink Href="#" style="Font-weight:bold;">Sign Out</MudLink>
        </div> 
        <div class="column" style="width:100px; float:right; padding-right:50px; padding-top:45px">
            <MudIcon Icon="@Icons.Material.Outlined.Person2" Title="Profile" Size="Size.Large" />
        </div>
        <div class="column" style="width:100px; float:right; padding-right:50px; padding-top:45px">
            <MudIcon Icon="@Icons.Material.Outlined.Notifications" Title="Alerts" Size="Size.Large" Iconcolor="Color.Primary"/>
        </div>
    </MudPaper>
   @*  <MudPaper Align="left" style="width:100%; height:35px; border:none; background-color:#F1F0EA">

        <MudText Typo="Typo.h5" Class="px-7" >Genera IVF</MudText>

    </MudPaper> *@
       

    <MudDivider></MudDivider>

    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Style="position:absolute; top:110px; height:calc(100dvh - 111px); width:250px; border:hidden; background-color:#f1f0ea">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent Class="pa-4" Style="height:calc(100dvh - 111px); overflow-y:scroll; background-color:#f8f8f4">
        @Body
    </MudMainContent>
</MudLayout>

